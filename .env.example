# Public site URL. Production example: https://cloutslot.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-side only; never expose the service role key in the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# NOWPayments
NOWPAYMENTS_API_KEY=...
NOWPAYMENTS_IPN_SECRET=...
# Optional override. Leave blank for production.
NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
